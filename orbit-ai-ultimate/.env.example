# Required for production database. Use a managed PostgreSQL URL on Render.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/orbit?sslmode=require"
NODE_ENV=production
PORT=10000
APP_ORIGIN=https://your-orbit-ai.onrender.com
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Providers: keys stay server-side; never put them in VITE_* variables.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b

# Optional research provider
TAVILY_API_KEY=

# Optional image generation via Gemini API (model must support image output for your key/account)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Limits
MAX_UPLOAD_MB=12
DAILY_MESSAGE_LIMIT=150
