generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  chats         Chat[]
  projects      Project[]
  documents     Document[]
  feedback      Feedback[]
  settings      UserSettings?
  usageLogs     UsageLog[]
}
model UserSettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  theme          String   @default("light")
  language       String   @default("auto")
  defaultMode    String   @default("compare")
  compareEnabled Boolean  @default(true)
  webSearch      Boolean  @default(false)
  systemPrompt   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
model Project {
  id           String   @id @default(cuid())
  userId       String
  name         String
  instructions String   @default("")
  color        String   @default("#6c63ff")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chats        Chat[]
  documents    Document[]
  @@index([userId, updatedAt])
}
model Chat {
  id        String    @id @default(cuid())
  userId    String
  projectId String?
  title     String    @default("New conversation")
  archived  Boolean   @default(false)
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]
  @@index([userId, updatedAt])
  @@index([projectId])
}
model Message {
  id          String   @id @default(cuid())
  chatId      String
  role        String
  content     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([chatId, createdAt])
}
model Document {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  name        String
  mimeType    String
  sizeBytes   Int
  textContent String   @db.Text
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([projectId])
}
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  chatId    String?
  messageId String?
  rating    Int
  note      String   @default("")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
model UsageLog {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  model        String
  inputChars   Int      @default(0)
  outputChars  Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
