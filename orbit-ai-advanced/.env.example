# Required for AI replies. Create at https://console.groq.com/keys
GROQ_API_KEY=replace_with_your_real_key
# Set to a model available in your Groq account; verify current model IDs in Groq Console.
GROQ_MODEL=openai/gpt-oss-20b
PORT=3000
NODE_ENV=development
# Database path. On Render attach a persistent disk mounted at /var/data and set DB_PATH=/var/data/orbit.sqlite
DB_PATH=./data/orbit.sqlite
# Optional: enables web research. Get a key from https://app.tavily.com/
TAVILY_API_KEY=
# Optional cap for normal chat messages per user per UTC day (default 100)
DAILY_MESSAGE_LIMIT=100
# Optional public site URL for deployment
APP_NAME=Orbit AI
